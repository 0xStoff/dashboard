# V2 local services. Copy to an untracked .env file and use a dedicated local database.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://dashboard:change-me@127.0.0.1:5432/dashboard_v2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Worker settings
WORKER_ID=local-worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=60

# Local-only portfolio providers. The DeBank key is required for EVM balances and DeFi.
# Never copy credentials from the Pi without deliberately authorizing that migration.
RABBY_ACCESS_KEY=
COINGECKO_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
APTOS_API_URL=https://api.mainnet.aptoslabs.com/v1

# Optional local-only viewer for an imported snapshot. Rejected in production.
# LOCAL_SNAPSHOT_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
